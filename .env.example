# OmniRoute Production & Local Environment Configuration
PORT=20128
HOST=0.0.0.0

# 32-byte Hex Storage Encryption Key (Required for at-rest encrypted credentials)
STORAGE_ENCRYPTION_KEY=

# Initial Administrator Password for Dashboard Login (Change upon first login!)
INITIAL_PASSWORD=CHANGEME_SET_STRONG_PASSWORD

# Security Settings
REQUIRE_API_KEY=true

# Optional Upstream Provider Keys (Or configure dynamically from the Web UI)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# KIMI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
